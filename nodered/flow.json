  {
    "id": "tpl_patients",
    "type": "ui_template",
    "z": "tab_bb",
    "name": "Patient Table",
    "group": "grp_patients",
    "order": 1,
    "width": 0,
    "height": 0,
    "format": "<style>\n.bbt{width:100%;border-collapse:collapse;font-family:Inter,Arial,sans-serif;font-size:12px;}\n.bbt th{background:#F1F5F9;color:#475569;font-weight:600;padding:6px 8px;text-align:left;border-bottom:2px solid #E2E8F0;white-space:nowrap;}\n.bbt td{padding:6px 8px;border-bottom:1px solid #F1F5F9;vertical-align:middle;white-space:nowrap;}\n.bbt tr:hover td{background:#F8FAFC;}\n.bdg{display:inline-block;padding:1px 9px;border-radius:20px;font-size:10.5px;font-weight:600;}\n.up{background:#EEF2FF;color:#4F46E5;}\n.du{background:#FFFBEB;color:#D97706;}\n.ov{background:#FEF2F2;color:#DC2626;}\n.vi{background:#F0FDF4;color:#16A34A;}\n.av{width:26px;height:26px;border-radius:50%;background:#DBEAFE;display:inline-flex;align-items:center;justify-content:center;font-size:12px;margin-right:5px;vertical-align:middle;}\n.ba{border:1px solid #CBD5E1;background:#fff;border-radius:5px;padding:2px 8px;font-size:10.5px;cursor:pointer;color:#1D4ED8;}\n.sb{width:100%;padding:5px 10px;border:1px solid #E2E8F0;border-radius:7px;font-size:12px;margin-bottom:7px;box-sizing:border-box;}\n.fb{padding:3px 10px;border-radius:20px;border:1px solid #CBD5E1;background:#fff;font-size:11px;cursor:pointer;margin-right:3px;margin-bottom:4px;}\n.fb.ac{background:#1E3A8A;color:#fff;border-color:#1E3A8A;}\n</style>\n<div style='font-family:Inter,Arial,sans-serif;padding:2px;'>\n  <div style='display:flex;align-items:center;gap:8px;margin-bottom:7px;flex-wrap:wrap;'>\n    <input class='sb' type='text' placeholder='&#128269; Search patient name or ID&hellip;' style='flex:1;min-width:200px;margin-bottom:0;'/>\n    <div>\n      <button class='fb ac'>All</button>\n      <button class='fb'>Upcoming</button>\n      <button class='fb'>Due</button>\n      <button class='fb'>Overdue</button>\n      <button class='fb'>Reminder Sent</button>\n      <button class='fb'>Visited</button>\n    </div>\n  </div>\n  <table class='bbt'>\n    <thead><tr>\n      <th>Patient</th><th>Patient ID</th><th>Condition</th>\n      <th>Last Visit</th><th>Next Follow-up</th><th>Status</th><th>Action</th>\n    </tr></thead>\n    <tbody>\n      <tr><td><span class='av'>&#128100;</span>Juan Dela Cruz</td><td style='color:#94A3B8;'>P-0016</td><td>Hypertension</td><td>Oct 15, 2025</td><td>Nov 20, 2026</td><td><span class='bdg up'>Upcoming</span></td><td><button class='ba'>&#128222; Contact</button></td></tr>\n      <tr><td><span class='av'>&#128100;</span>Maria Santos</td><td style='color:#94A3B8;'>P-0034</td><td>Diabetes</td><td>Oct 10, 2025</td><td>Nov 18, 2025</td><td><span class='bdg du'>Due</span></td><td><button class='ba'>&#128222; Contact</button></td></tr>\n      <tr><td><span class='av'>&#128100;</span>Pedro Reyes</td><td style='color:#94A3B8;'>P-0021</td><td>Tuberculosis</td><td>Oct 17, 2025</td><td>Nov 17, 2025</td><td><span class='bdg ov'>Overdue</span></td><td><button class='ba'>&#9993; Reminder</button></td></tr>\n      <tr><td><span class='av'>&#128100;</span>Ana Garcia</td><td style='color:#94A3B8;'>P-0040</td><td>Hypertension</td><td>Oct 12, 2025</td><td>Oct 22, 2025</td><td><span class='bdg du'>Due</span></td><td><button class='ba'>&#128222; Contact</button></td></tr>\n      <tr><td><span class='av'>&#128100;</span>Luis Navarro</td><td style='color:#94A3B8;'>P-0071</td><td>Diabetes</td><td>Oct 17, 2024</td><td>Nov 14, 2025</td><td><span class='bdg up'>Upcoming</span></td><td><button class='ba'>&#128065; View</button></td></tr>\n      <tr><td><span class='av'>&#128100;</span>Carla Santos</td><td style='color:#94A3B8;'>P-0105</td><td>Hypertension</td><td>Nov 12, 2025</td><td>Dec 1, 2025</td><td><span class='bdg up'>Upcoming</span></td><td><button class='ba'>&#128065; View</button></td></tr>\n      <tr><td><span class='av'>&#128100;</span>Ramon Cruz</td><td style='color:#94A3B8;'>P-0110</td><td>Tuberculosis</td><td>Nov 8, 2025</td><td>Nov 6, 2025</td><td><span class='bdg vi'>Visited</span></td><td><button class='ba'>&#128065; View</button></td></tr>\n      <tr><td><span class='av'>&#128100;</span>Bea Lopez</td><td style='color:#94A3B8;'>P-0124</td><td>Diabetes</td><td>Nov 12, 2024</td><td>Nov 10, 2025</td><td><span class='bdg vi'>Visited</span></td><td><button class='ba'>&#128065; View</button></td></tr>\n    </tbody>\n  </table>\n</div>",
